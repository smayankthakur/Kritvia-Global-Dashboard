# Copy to .env (never commit .env). Generate secrets with:
#   openssl rand -base64 32                     (passwords, tokens, JWT secret)
#   python -m kritvia_api.cli new-kek           (MASTER_KEK_B64 — BACK THIS UP OFFLINE; losing it loses all encrypted data)

ENVIRONMENT=production
POSTGRES_PASSWORD=
KRITVIA_OWNER_PASSWORD=
KRITVIA_APP_PASSWORD=
VALKEY_PASSWORD=

JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
MASTER_KEK_B64=
MASTER_KEK_ID=local-v1

# Public URLs (used in upload links, webhook URLs and the Google OAuth redirect)
PUBLIC_WEB_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGINS=["https://app.example.com"]
# Only if the API is reachable exclusively through Cloudflare Tunnel (the web BFF forwards it):
CLIENT_IP_HEADER=cf-connecting-ip

# Sandbox runner (services/sandbox); SANDBOX_RUNTIME=runc only for machines without gVisor (NOT production)
SANDBOX_TOKEN=
SANDBOX_RUNTIME=runsc

# Outbound mail when a venture has no Google connector: log (record only) | none (fail)
MESSAGING_FALLBACK=log

# Google Workspace OAuth (keep the app in "testing" mode while dogfooding)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/api/oauth/google/callback   # web app route (binds the flow to the browser)

# WhatsApp Business (Meta Cloud API). In Meta for Developers: App settings → Basic → App secret;
# the verify token is any string you choose, typed into the webhook setup. Webhook URL:
# https://<api host>/hooks/whatsapp (subscribe to "messages"). Each business pastes its own
# phone number id + permanent token in Settings → Connectors.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Self-signup: "Sign in with Google" uses the Google client above (same redirect URI);
# email sign-in sends a 6-digit code. SIGNUP_OPEN=false: only existing accounts can sign in.
SIGNUP_OPEN=true
# smtp | log (code written to `docker compose logs api`; refused in production while SIGNUP_OPEN=true) | memory (tests)
MAIL_TRANSPORT=smtp
MAIL_FROM=Kritvia <no-reply@sitelytc.com>
SMTP_HOST=          # e.g. email-smtp.ap-south-1.amazonaws.com (Amazon SES), smtp.zoho.in, smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

LITELLM_MASTER_KEY=
LITELLM_API_KEY=            # same value as LITELLM_MASTER_KEY for the API's calls

# Free-tier providers (internal, non-sensitive data only — see infra/litellm/tiers.yaml)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# More free models that do not train on inputs (each needs only a free sign-up):
CEREBRAS_API_KEY=           # https://cloud.cerebras.ai  (free tier, no retention)
CLOUDFLARE_API_KEY=         # Workers AI token: dash.cloudflare.com -> AI -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=            # https://console.mistral.ai (free tier may train unless you opt out in Admin -> Privacy)
# Deployments whose key no longer lets the provider train (billing on, or opt-out set), comma-separated,
# e.g. AI_NO_TRAINING_DEPLOYMENTS=gemini-flash,mistral-large
AI_NO_TRAINING_DEPLOYMENTS=

# Optional: Sarvam speech-to-text for Hindi, Hinglish and other Indian languages (dictation).
# Empty = skipped, dictation falls back to Whisper. Called by the API directly, not through LiteLLM.
SARVAM_API_KEY=

# Optional: pyannote diarization sidecar (services/diarization)
DIARIZATION_URL=
DIARIZATION_TOKEN=
HF_TOKEN=

# Cloudflare Tunnel (compose profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=

# Off-VM backups (infra/scripts/backup.sh)
BACKUP_AGE_RECIPIENT=       # age public key; the private key never lives on the VM
BACKUP_RCLONE_REMOTE=       # e.g. :s3,provider=AWS,env_auth=true,no_check_bucket=true,region=ap-south-1:kritvia-backups-123456789012

# Ops alerts (infra/scripts/healthcheck.sh): AWS SNS topic that emails you; publish allowed by the instance role
ALERT_SNS_TOPIC_ARN=

# Plans and billing. Organisations without a plan get DEFAULT_PLAN (free | starter | growth | scale | enterprise | internal).
DEFAULT_PLAN=free
# Razorpay (Dashboard -> Settings -> API keys; Subscriptions -> Plans for the two plan ids;
# Webhooks -> https://api.<domain>/public/billing/razorpay with the subscription.* and invoice.paid events)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web push ("a draft needs your yes" on phones and laptops). Generate once with
#   python3 infra/scripts/vapid-keys.py >> .env
# Empty = notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sitelytc.com
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_STARTER_ANNUAL=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_GROWTH_ANNUAL=
RAZORPAY_PLAN_SCALE=
RAZORPAY_PLAN_SCALE_ANNUAL=
# Set to the moment online payment goes live (ISO 8601, e.g. 2026-11-01T00:00:00+05:30). Until it
# is set, 15-day free trials are held open; after, unpaid trials end 3 days later at the earliest.
PAYMENTS_LIVE_AT=
# Help-page contact form: messages are always stored (infra/scripts/support-inbox.sh) and also
# emailed here when MAIL_TRANSPORT=smtp.
SUPPORT_INBOX=
NEXT_PUBLIC_SUPPORT_EMAIL=support@sitelytc.com

# --- Managed database (optional; see docs/runbook.md "Growing beyond one server") -----------
# When set, run every compose command with "-f docker-compose.yml -f docker-compose.managed.yml"
# (infra/scripts/deploy.sh does this automatically) and move the data once with
# infra/scripts/migrate-to-managed-db.sh.
# MANAGED_DATABASE_URL=postgresql+asyncpg://kritvia_app:<app pw>@<rds host>:5432/kritvia
# MANAGED_MIGRATION_DATABASE_URL=postgresql://kritvia_owner:<owner pw>@<rds host>:5432/kritvia
# MANAGED_REDIS_URL=                      # leave unset to keep Valkey on the VM
# WORKER_REPLICAS=2

# Registered office shown in email footers (and NEXT_PUBLIC_COMPANY_ADDRESS / NEXT_PUBLIC_COMPANY_GSTIN
# for the website footer, set at build time).
COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_GSTIN=
